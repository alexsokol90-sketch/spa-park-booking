# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
DATABASE_URL=postgresql://spa:spa@127.0.0.1:5432/spa
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
MAX_BOT_TOKEN=
MAX_ADMIN_CHAT_ID=
ADMIN_USER=admin
ADMIN_PASSWORD=
PAYMENT_URL=https://spa-park.example/pay
PORT=3030
# Telegram: токен от @BotFather. Чат администратора — TG_ADMIN_CHAT_ID или команда боту «/admin <ADMIN_PASSWORD>».
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
# Ретранслятор Bot API, если сервер в РФ (по умолчанию https://api.telegram.org)
TG_API_BASE=
# VK: ключ доступа сообщества (права «сообщения»), ID сообщества. Чат администратора — «/admin <ADMIN_PASSWORD>».
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_ADMIN_PEER_ID=
# Языковая модель для РФ: GigaChat (developers.sber.ru → проект → «Ключ авторизации»).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# AI-агент Timeweb Cloud (OpenAI-совместимый API): адрес из вкладки «Дашборд» агента и API-токен.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=yandexgpt
